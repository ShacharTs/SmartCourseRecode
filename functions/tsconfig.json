{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2019",
    "outDir": "lib",
    "rootDir": "src",
    "esModuleInterop": true,
    "sourceMap": true,

    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,

    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}
